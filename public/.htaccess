<IfModule mod_rewrite.c>
  RewriteEngine On

  # 301 Redirect non-www to www (canonical domain)
  RewriteCond %{HTTP_HOST} ^emperorakbar\.com$ [NC]
  RewriteRule ^(.*)$ https://www.emperorakbar.com/$1 [L,R=301]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://www.emperorakbar.com/$1 [L,R=301]
</IfModule>
